# Local environment variables for spec-devloop
# This file is for local development only. DO NOT commit it to version control.
# API keys and secrets should never be committed to repositories.

# vLLM API Key (for local OpenAI-compatible endpoints)
# Get your API key from your vLLM instance or leave empty if not required
VLLM_API_KEY=your-api-key-here

# IMPORTANT: The CLI does NOT automatically load .env files.
# To use this file, load it manually into your shell environment:

# For bash/zsh:
#   set -a
#   source .env
#   set +a

# For fish shell:
#   set -a; source .env; set +a

# Alternatively, export variables directly:
#   export VLLM_API_KEY=your-api-key-here